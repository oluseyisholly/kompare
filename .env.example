# Fill in your local database settings here.
# These values are loaded by app/core/database.py and migrations/env.py.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kompare
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Browser access: * allows all origins. A comma-separated list restricts origins.
CORS_ALLOW_ORIGINS=*

# Provider API base URLs
QUIDAX_BASE_URL=https://openapi.quidax.io
QUIDAX_API_KEY=
QUIDAX_KYC_URL=https://support.quidax.io/hc/en-us/articles/13812153745564-KYC-Documents-and-Limits

BUSHA_BASE_URL=https://api.sandbox.busha.so
BUSHA_API_KEY=
BUSHA_KYC_IDENTITY_URL=https://support.busha.io/en/articles/2631291-how-do-i-verify-my-identity
BUSHA_KYC_LIMITS_URL=https://support.busha.io/en/articles/2137037-verification-levels-and-limits
CARDTONIC_BASE_URL=https://api.cardtonic.com
CARDTONIC_KYC_URL=https://help.cardtonic.com/en/articles/6811777-what-is-kyc-and-how-does-it-apply-to-cardtonic
TBAY_BASE_URL=https://api.tbay.store
TBAY_SITE_URL=https://h5.tbay.store
TBAY_CLIENT_VERSION=1.10.16
TBAY_SIGNING_SALT=IgaO0cpIJp
CARDTONIC_SITE_URL=https://cardtonic.com
CARDTONIC_API_ENV=production

# Auth settings
# Required: generate a private value with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_OTP_EXPIRE_MINUTES=10
EMAIL_VERIFICATION_OTP_LENGTH=6
# true requires the real emailed OTP; false also accepts 000000 for testing.
IS_PRODUCTION=true
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_OTP_LENGTH=6

# In-app ingestion scheduler
ENABLE_INGESTION_SCHEDULER=false
INGESTION_SCHEDULER_POLL_SECONDS=60

# SMTP email settings
# Brevo example:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=
EMAIL_FROM_NAME=Kompare

# Public mutual-fund sources (no API keys or secrets required)
STANBIC_BASE_URL=https://blunest.stanbicibtcassetmanagement.com
UNITED_CAPITAL_BASE_URL=https://unitedcapitalplcgroup.com
# United Capital source-date freshness policy (days), not polling frequency
UNITED_CAPITAL_STALE_AFTER_DAYS=7

# Wise FX data (optional; missing credentials do not block startup)
WISE_BASE_URL=https://api.wise.com
WISE_API_VERSION=2026Q4
WISE_API_TOKEN=
# Optional partner client-credentials token for partner-priced illustrative quotes.
# Do not substitute a personal API token here.
WISE_QUOTE_CLIENT_TOKEN=

# Shared local FX calculation freshness.
FX_RATE_STALE_AFTER_SECONDS=3600

# Flutterwave v3 transfer-rate samples (optional, no money movement)
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_SECRET_KEY=
# v3 uses the same host; use the appropriate test or live secret key.
# Optional override; [] uses built-in NGN <-> USD/GBP/EUR collection pairs.
# Route availability is checked by the provider for each request.
FLUTTERWAVE_FX_SCENARIOS=[]

# Fincra: sandbox or production; use the matching secret key.
FINCRA_SECRET_KEY=

FINCRA_BASE_URL=https://sandboxapi.fincra.com

# Shared authentication limits (same database across API replicas)
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_IP_LIMIT=60
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_IP_LIMIT=20
AUTH_EMAIL_ACCOUNT_LIMIT=3

# Durable ingestion worker (run separately from the API)
INGESTION_WORKER_POLL_SECONDS=5
INGESTION_JOB_LEASE_SECONDS=300
INGESTION_JOB_MAX_ATTEMPTS=3

# Uvicorn trusts forwarded IP headers only from these proxy peers.
# Set to your actual trusted proxy IPs when deployed; never use * on a public listener.
FORWARDED_ALLOW_IPS=127.0.0.1
