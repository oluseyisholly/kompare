# Fill in your local database settings here.
# These values are loaded by app/core/database.py and migrations/env.py.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kompare
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Provider API base URLs
QUIDAX_BASE_URL=https://openapi.quidax.io
QUIDAX_API_KEY=
QUIDAX_KYC_URL=https://support.quidax.io/hc/en-us/articles/13812153745564-KYC-Documents-and-Limits

BUSHA_BASE_URL=https://api.sandbox.busha.so
BUSHA_API_KEY=
BUSHA_KYC_IDENTITY_URL=https://support.busha.io/en/articles/2631291-how-do-i-verify-my-identity
BUSHA_KYC_LIMITS_URL=https://support.busha.io/en/articles/2137037-verification-levels-and-limits

# Auth settings
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# In-app ingestion scheduler
ENABLE_INGESTION_SCHEDULER=false
INGESTION_SCHEDULER_POLL_SECONDS=60
